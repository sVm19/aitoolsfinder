# ==============================================================================
# AIToolsFinder.cloud — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.
# Official Domain: https://aitoolsfinder.cloud

# ------------------------------------------------------------------------------
# Backend Configuration (backend/)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","https://aitoolsfinder.cloud"]

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# 1. Supabase Session Pooler (port 5432):
#    DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
#    DATABASE_URL_SYNC=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# 2. Local Fallback Database (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aitoolsfinder
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aitoolsfinder
DB_SSL_MODE=

# Supabase API Keys (Optional SDK integration)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# AWS Cognito (Authentication)
# ------------------------------------------------------------------------------
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_APP_CLIENT_ID=exampleappclientid123456789
COGNITO_DOMAIN=auth.aitoolsfinder.cloud

# ------------------------------------------------------------------------------
# AWS Infrastructure (ECR, S3, CloudFront)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_FRONTEND_REPOSITORY=aitoolsfinder-frontend
ECR_BACKEND_REPOSITORY=aitoolsfinder-backend
S3_BUCKET_NAME=aitoolsfinder-media
CLOUDFRONT_DOMAIN=cdn.aitoolsfinder.cloud

# ------------------------------------------------------------------------------
# AI Engine (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-examplekey
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT_SECONDS=10
OPENROUTER_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Payments (Tiun Business - Subject to Provider Verification)
# ------------------------------------------------------------------------------
TIUN_API_KEY=tiun_live_or_test_key
TIUN_WEBHOOK_SECRET=whsec_exampletiunsecret

# ------------------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_examplekey123456
EMAIL_FROM=notifications@aitoolsfinder.cloud

# ------------------------------------------------------------------------------
# Analytics (PostHog)
# ------------------------------------------------------------------------------
POSTHOG_API_KEY=phc_examplekey123456
POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://aitoolsfinder.cloud
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_examplepool
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=exampleappclientid123456789
NEXT_PUBLIC_POSTHOG_KEY=phc_examplekey123456
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
